---
import "../styles/global.css";
---

<section
  id="juegos"
  class="relative overflow-hidden bg-gradient-to-b from-purple-50 via-white to-pink-50 px-4 py-16 sm:px-6 lg:px-8"
>
  <!-- DECORACIÓN DE FONDO -->
  <div class="pointer-events-none absolute -left-32 top-20 h-80 w-80 rounded-full bg-purple-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-32 top-[45%] h-96 w-96 rounded-full bg-pink-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-yellow-100/50 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl">

    <!-- VOLVER AL INICIO -->
    <a
      href="/"
      class="mb-10 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-purple-700 shadow-md transition hover:-translate-x-1 hover:bg-purple-50 hover:shadow-lg"
    >
      ← Volver al inicio
    </a>

    <!-- ENCABEZADO -->
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-pink-50 px-4 py-1.5 text-xs font-black uppercase tracking-wide text-pink-500"
      >
        🎮 Aprende jugando
      </span>

      <h1 class="mt-4 text-4xl font-black text-purple-700 md:text-5xl">
        Juegos educativos
      </h1>

      <p class="mt-4 text-base leading-7 text-gray-600 md:text-lg">
        Diviértete mientras aprendes sobre el respeto, los límites,
        la protección y la importancia de pedir ayuda.
      </p>
    </div>

    <!-- =====================================================
         JUEGO 1 - SOPA DE LETRAS
    ====================================================== -->

    <div
      id="sopa"
      class="mt-12 rounded-[2rem] border border-purple-100 bg-white/90 p-5 shadow-xl backdrop-blur-sm md:p-8"
    >
      <div class="text-center">
        <span class="text-4xl">🔎</span>

        <h2 class="mt-3 text-2xl font-black text-purple-700 md:text-3xl">
          Sopa de letras
        </h2>

        <p class="mt-2 text-gray-600">
          Encuentra las palabras relacionadas con la protección y el cuidado.
        </p>
      </div>

      <!-- PALABRAS -->
      <div
        id="listaPalabras"
        class="mx-auto mt-7 flex max-w-3xl flex-wrap justify-center gap-2"
      >
      </div>

      <!-- TABLERO -->
      <div
        class="mt-8 overflow-x-auto rounded-3xl bg-gradient-to-br from-purple-900 via-purple-800 to-indigo-900 p-4 shadow-inner md:p-6"
      >
        <div
          id="grid"
          class="mx-auto grid w-max gap-1.5"
          style="grid-template-columns: repeat(12, minmax(0, 1fr));"
        >
        </div>
      </div>

      <!-- CONTADOR -->
      <div class="mt-6 text-center">
        <p
          id="contador"
          class="inline-flex rounded-full bg-purple-100 px-5 py-2 font-black text-purple-700"
        >
          Palabras encontradas: 0 / 7
        </p>

        <p
          id="ganaste"
          class="mt-4 hidden text-2xl font-black text-green-600"
        >
          🎉 ¡Felicidades! Encontraste todas las palabras 🎉
        </p>
      </div>
    </div>

    <!-- =====================================================
         JUEGO 2 - TEST
    ====================================================== -->

    <div
      id="test"
      class="mt-10 rounded-[2rem] border border-pink-100 bg-gradient-to-br from-white to-pink-50 p-5 shadow-xl md:p-8"
    >
      <div class="text-center">
        <span class="text-4xl">🧠</span>

        <h2 class="mt-3 text-2xl font-black text-purple-700 md:text-3xl">
          Test de aprendizaje
        </h2>

        <p class="mt-2 text-gray-600">
          Responde las preguntas y comprueba cuánto has aprendido.
        </p>
      </div>

      <div
        class="mx-auto mt-8 max-w-3xl rounded-3xl bg-gradient-to-br from-purple-700 to-purple-900 p-6 text-white shadow-lg md:p-8"
      >
        <!-- PROGRESO -->
        <div class="mb-6">
          <div class="mb-2 flex justify-between text-sm font-bold text-purple-100">
            <span>Progreso</span>
            <span id="progresoTest">1 / 5</span>
          </div>

          <div class="h-2 overflow-hidden rounded-full bg-white/20">
            <div
              id="barraProgreso"
              class="h-full w-0 rounded-full bg-pink-400 transition-all duration-500"
            ></div>
          </div>
        </div>

        <h3
          id="pregunta"
          class="text-center text-xl font-black leading-8 md:text-2xl"
        ></h3>

        <div id="opciones" class="mt-7 space-y-3"></div>

        <p
          id="resultado"
          class="mt-6 min-h-[32px] text-center text-lg font-black"
        ></p>
      </div>
    </div>

    <!-- =====================================================
         JUEGO 3 - ARRASTRAR
    ====================================================== -->

    <div
      id="juego"
      class="mt-10 rounded-[2rem] border border-yellow-100 bg-gradient-to-br from-white via-yellow-50/40 to-purple-50 p-5 shadow-xl md:p-8"
    >
      <div class="text-center">
        <span class="text-4xl">🎯</span>

        <h2 class="mt-3 text-2xl font-black text-purple-700 md:text-3xl">
          Juego de acciones
        </h2>

        <p class="mt-2 text-gray-600">
          Arrastra cada acción hacia el lugar que consideres correcto.
        </p>
      </div>

      <!-- TARJETAS -->
      <div
        id="arrastrarJuego"
        class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
      >
        <div
          class="tarjeta cursor-grab rounded-2xl border border-purple-100 bg-white p-5 text-center font-bold text-purple-700 shadow-md transition hover:-translate-y-1 hover:shadow-lg active:cursor-grabbing"
          draggable="true"
          id="t1"
        >
          🗣️ Contarle a un adulto
        </div>

        <div
          class="tarjeta cursor-grab rounded-2xl border border-purple-100 bg-white p-5 text-center font-bold text-purple-700 shadow-md transition hover:-translate-y-1 hover:shadow-lg active:cursor-grabbing"
          draggable="true"
          id="t2"
        >
          🤐 Guardar silencio
        </div>

        <div
          class="tarjeta cursor-grab rounded-2xl border border-purple-100 bg-white p-5 text-center font-bold text-purple-700 shadow-md transition hover:-translate-y-1 hover:shadow-lg active:cursor-grabbing"
          draggable="true"
          id="t3"
        >
          🆘 Pedir ayuda
        </div>

        <div
          class="tarjeta cursor-grab rounded-2xl border border-purple-100 bg-white p-5 text-center font-bold text-purple-700 shadow-md transition hover:-translate-y-1 hover:shadow-lg active:cursor-grabbing"
          draggable="true"
          id="t4"
        >
          👩‍🏫 Hablar con un profesor
        </div>

        <div
          class="tarjeta cursor-grab rounded-2xl border border-purple-100 bg-white p-5 text-center font-bold text-purple-700 shadow-md transition hover:-translate-y-1 hover:shadow-lg active:cursor-grabbing"
          draggable="true"
          id="t5"
        >
          🙈 Esconder lo que pasa
        </div>

        <div
          class="tarjeta cursor-grab rounded-2xl border border-purple-100 bg-white p-5 text-center font-bold text-purple-700 shadow-md transition hover:-translate-y-1 hover:shadow-lg active:cursor-grabbing"
          draggable="true"
          id="t6"
        >
          🛡️ Buscar protección
        </div>
      </div>

      <!-- ZONAS -->
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <div
          id="correcto"
          class="drop-zone min-h-[180px] rounded-3xl border-2 border-dashed border-green-300 bg-green-50 p-6 text-center transition"
        >
          <div class="text-4xl">✅</div>

          <h3 class="mt-2 text-xl font-black text-green-700">
            Acciones seguras
          </h3>

          <p class="mt-2 text-sm text-green-700/70">
            Suelta aquí las acciones que ayudan a protegerte.
          </p>
        </div>

        <div
          id="incorrecto"
          class="drop-zone min-h-[180px] rounded-3xl border-2 border-dashed border-red-300 bg-red-50 p-6 text-center transition"
        >
          <div class="text-4xl">❌</div>

          <h3 class="mt-2 text-xl font-black text-red-700">
            Acciones incorrectas
          </h3>

          <p class="mt-2 text-sm text-red-700/70">
            Coloca aquí las acciones que no ayudan.
          </p>
        </div>
      </div>

      <p
        id="mensajeJuego"
        class="mt-6 min-h-[32px] text-center text-lg font-black"
      ></p>
    </div>

    <!-- =====================================================
         JUEGO 4 - ¿QUIÉN DICE LA VERDAD?
    ====================================================== -->

    <div
      id="quien-dice-la-verdad"
      class="mt-10 rounded-[2rem] border border-purple-100 bg-white/90 p-5 shadow-xl backdrop-blur-sm md:p-8"
    >
      <div class="text-center">
        <span class="text-4xl">🛡️</span>

        <h2 class="mt-3 text-2xl font-black text-purple-700 md:text-3xl">
          ¿Quién dice la verdad?
        </h2>

        <p class="mt-2 text-gray-600">
          Escucha cada mensaje y descubre cuáles enseñan formas seguras
          de cuidarte y pedir ayuda.
        </p>
      </div>

      <div id="vd-app" class="mt-6">

        <!-- PANTALLA DE INICIO -->
        <section id="vd-inicio" class="vd-panel vd-inicio">
          <div class="vd-escudo" aria-hidden="true">🛡️</div>
          <h3 class="vd-titulo">¡Conviértete en guardián de la verdad!</h3>
          <p class="vd-parrafo">
            Cada personaje dirá una frase. Decide si es un
            <strong>mensaje correcto</strong> o un
            <strong>mensaje incorrecto</strong>.
          </p>

          <div class="vd-reglas">
            <div class="vd-regla">
              <span aria-hidden="true">👂</span>
              <strong>Lee bien</strong> cada mensaje.
            </div>
            <div class="vd-regla">
              <span aria-hidden="true">🤔</span>
              <strong>Piensa</strong> si te ayuda a cuidarte.
            </div>
            <div class="vd-regla">
              <span aria-hidden="true">✅</span>
              <strong>Elige</strong> y aprende por qué es así.
            </div>
          </div>

          <button id="vd-comenzar" class="vd-boton" type="button">
            Comenzar el juego 🚀
          </button>
        </section>

        <!-- PANTALLA DE JUEGO -->
        <section id="vd-juego" class="vd-panel vd-oculto" aria-live="polite">
          <div class="vd-barra-superior">
            <div
              id="vd-progreso"
              class="vd-progreso-contenedor"
              role="progressbar"
              aria-label="Progreso del juego"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <div id="vd-barra" class="vd-progreso"></div>
            </div>
            <div id="vd-marcador" class="vd-marcador">⭐ 0 aciertos</div>
          </div>

          <div id="vd-numero" class="vd-numero-pregunta"></div>

          <div class="vd-escena">
            <div id="vd-personaje" class="vd-personaje" role="img" aria-label="Personaje del juego"></div>
            <div id="vd-mensaje" class="vd-mensaje"></div>
          </div>

          <p class="vd-instruccion">¿Es correcto lo que dice?</p>

          <div class="vd-respuestas">
            <button class="vd-respuesta vd-si" data-respuesta="true" type="button">
              ✅ Sí, es correcto
            </button>
            <button class="vd-respuesta vd-no" data-respuesta="false" type="button">
              ❌ No, es incorrecto
            </button>
          </div>

          <div id="vd-retro" class="vd-retro vd-oculto" role="status"></div>

          <button id="vd-siguiente" class="vd-boton vd-siguiente vd-oculto" type="button">
            Siguiente mensaje ➜
          </button>
        </section>

        <!-- PANTALLA FINAL -->
        <section id="vd-final" class="vd-panel vd-final vd-oculto">
          <div class="vd-trofeo" aria-hidden="true">🏆</div>
          <h3 class="vd-titulo">¡Misión completada!</h3>

          <div id="vd-puntos" class="vd-puntuacion"></div>
          <div id="vd-motivacion" class="vd-motivacion"></div>

          <div class="vd-recordatorios">
            <h4>Tu escudo protector recuerda:</h4>
            <ul>
              <li><strong>Puedes decir "NO"</strong> si algo te hace sentir incómodo, asustado o confundido.</li>
              <li><strong>Tu cuerpo te pertenece</strong> y mereces que respeten tus límites.</li>
              <li><strong>Los secretos que asustan</strong> deben contarse a un adulto de confianza.</li>
              <li><strong>Nunca es culpa del niño</strong> cuando un adulto o una persona mayor no respeta las reglas de cuidado.</li>
              <li><strong>Sigue buscando ayuda</strong> hasta encontrar a una persona que te escuche y te proteja.</li>
            </ul>
          </div>

          <button id="vd-reiniciar" class="vd-boton" type="button">
            Jugar otra vez 🔄
          </button>

          <div class="vd-ayuda">
            Si una situación te preocupa, habla con una persona adulta
            de confianza, como un familiar protector, docente, orientador
            escolar o profesional de salud. Si existe peligro inmediato,
            busca los servicios de emergencia de tu localidad.
          </div>
        </section>

      </div>
    </div>

  </div>
</section>

<!-- =====================================================
     ESTILOS DEL JUEGO 4 (todos empiezan con #vd-app
     para no afectar al resto de la página)
====================================================== -->

<style is:global>
  #vd-app {
    --vd-morado: #6c4bd8;
    --vd-morado-oscuro: #49319c;
    --vd-celeste: #39bce8;
    --vd-amarillo: #ffd95a;
    --vd-verde-claro: #e8fff3;
    --vd-rojo-claro: #fff0f1;
    --vd-azul-oscuro: #25335b;
    --vd-sombra: 0 14px 35px rgba(62, 47, 119, 0.18);

    padding: clamp(12px, 3vw, 24px);
    border-radius: 1.5rem;
    color: var(--vd-azul-oscuro);
    font-family: "Trebuchet MS", "Arial Rounded MT Bold", Arial, sans-serif;
    background:
      radial-gradient(circle at 10% 10%, #fff1a8 0 6%, transparent 7%),
      radial-gradient(circle at 90% 15%, #ffc9e4 0 8%, transparent 9%),
      linear-gradient(135deg, #e5fbff, #f2eaff 55%, #fff7cf);
  }

  #vd-app * {
    box-sizing: border-box;
  }

  #vd-app .vd-oculto {
    display: none !important;
  }

  #vd-app .vd-panel {
    padding: clamp(18px, 4vw, 34px);
    border: 4px solid rgba(255, 255, 255, 0.9);
    border-radius: 34px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--vd-sombra);
  }

  #vd-app .vd-inicio,
  #vd-app .vd-final {
    text-align: center;
  }

  #vd-app .vd-titulo {
    margin: 0 0 12px;
    color: var(--vd-morado-oscuro);
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 900;
    line-height: 1.15;
  }

  #vd-app .vd-parrafo {
    margin: 0;
    line-height: 1.5;
  }

  #vd-app .vd-escudo {
    display: grid;
    width: 130px;
    height: 130px;
    margin: 4px auto 18px;
    place-items: center;
    border: 8px solid #ffffff;
    border-radius: 38% 38% 50% 50%;
    color: white;
    background: linear-gradient(145deg, var(--vd-celeste), var(--vd-morado));
    box-shadow: 0 12px 25px rgba(76, 55, 167, 0.25);
    font-size: 4rem;
    transform: rotate(2deg);
  }

  #vd-app .vd-reglas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 24px 0;
    text-align: left;
  }

  #vd-app .vd-regla {
    padding: 16px;
    border-radius: 22px;
    background: #f4f0ff;
    line-height: 1.35;
  }

  #vd-app .vd-regla span {
    display: block;
    margin-bottom: 6px;
    font-size: 1.8rem;
  }

  #vd-app .vd-boton {
    min-height: 56px;
    padding: 13px 25px;
    border: 0;
    border-radius: 18px;
    color: white;
    background: linear-gradient(135deg, var(--vd-morado), var(--vd-morado-oscuro));
    box-shadow: 0 8px 0 #352179;
    font-size: 1.1rem;
    font-weight: 900;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  #vd-app .vd-boton:hover {
    transform: translateY(-2px);
  }

  #vd-app .vd-boton:active {
    transform: translateY(5px);
    box-shadow: 0 3px 0 #352179;
  }

  #vd-app .vd-barra-superior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
  }

  #vd-app .vd-progreso-contenedor {
    flex: 1;
    height: 18px;
    overflow: hidden;
    border: 3px solid #ffffff;
    border-radius: 999px;
    background: #ded7f9;
    box-shadow: inset 0 2px 4px rgba(46, 34, 99, 0.15);
  }

  #vd-app .vd-progreso {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--vd-celeste), var(--vd-morado));
    transition: width 0.4s ease;
  }

  #vd-app .vd-marcador {
    min-width: 105px;
    padding: 9px 12px;
    border-radius: 16px;
    background: var(--vd-amarillo);
    font-weight: 900;
    text-align: center;
  }

  #vd-app .vd-numero-pregunta {
    margin-bottom: 12px;
    color: var(--vd-morado);
    font-weight: 900;
    text-align: center;
  }

  #vd-app .vd-escena {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 22px;
    align-items: center;
  }

  #vd-app .vd-personaje {
    display: grid;
    min-height: 200px;
    place-items: center;
    border-radius: 34px;
    background: linear-gradient(145deg, #fff3ae, #ffcbe0);
    box-shadow: inset 0 0 0 4px white;
    font-size: 6.5rem;
  }

  #vd-app .vd-mensaje {
    position: relative;
    min-height: 160px;
    padding: 28px;
    border: 4px solid #e6dfff;
    border-radius: 28px;
    background: #ffffff;
    font-size: clamp(1.22rem, 4vw, 1.75rem);
    font-weight: 900;
    line-height: 1.35;
  }

  #vd-app .vd-mensaje::before {
    position: absolute;
    top: 50%;
    left: -22px;
    width: 36px;
    height: 36px;
    content: "";
    background: white;
    border-bottom: 4px solid #e6dfff;
    border-left: 4px solid #e6dfff;
    transform: translateY(-50%) rotate(45deg);
  }

  #vd-app .vd-instruccion {
    margin: 24px 0 14px;
    font-weight: 900;
    text-align: center;
  }

  #vd-app .vd-respuestas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  #vd-app .vd-respuesta {
    min-height: 74px;
    padding: 14px;
    border: 0;
    border-radius: 22px;
    color: white;
    font-size: 1.16rem;
    font-weight: 900;
    cursor: pointer;
    transition: transform 0.15s, filter 0.15s;
  }

  #vd-app .vd-respuesta:hover {
    transform: scale(1.025);
    filter: brightness(1.04);
  }

  #vd-app .vd-respuesta:disabled {
    cursor: default;
    opacity: 0.65;
    transform: none;
  }

  #vd-app .vd-si {
    background: linear-gradient(135deg, #3bc982, #21985e);
    box-shadow: 0 7px 0 #147545;
  }

  #vd-app .vd-no {
    background: linear-gradient(135deg, #ff7982, #d9455a);
    box-shadow: 0 7px 0 #a52e40;
  }

  #vd-app .vd-retro {
    margin-top: 20px;
    padding: 18px;
    border-radius: 22px;
    font-weight: 800;
    line-height: 1.5;
  }

  #vd-app .vd-retro.vd-bien {
    color: #176740;
    background: var(--vd-verde-claro);
    border: 3px solid #74dbaa;
  }

  #vd-app .vd-retro.vd-revisar {
    color: #902f3b;
    background: var(--vd-rojo-claro);
    border: 3px solid #ff9ea7;
  }

  #vd-app .vd-siguiente {
    display: block;
    margin: 18px auto 0;
  }

  #vd-app .vd-trofeo {
    margin-bottom: 12px;
    font-size: 5rem;
    animation: vd-celebrar 0.8s ease-in-out infinite alternate;
  }

  @keyframes vd-celebrar {
    from { transform: rotate(-5deg) scale(1); }
    to { transform: rotate(5deg) scale(1.08); }
  }

  #vd-app .vd-puntuacion {
    display: inline-block;
    margin: 14px 0 20px;
    padding: 13px 24px;
    border-radius: 20px;
    color: var(--vd-morado-oscuro);
    background: var(--vd-amarillo);
    font-size: 1.35rem;
    font-weight: 900;
  }

  #vd-app .vd-motivacion {
    margin: 20px auto;
    padding: 20px;
    border-radius: 22px;
    background: linear-gradient(135deg, #e8fff3, #fff7cf);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.5;
  }

  #vd-app .vd-recordatorios {
    max-width: 680px;
    margin: 0 auto 24px;
    padding: 20px;
    border-radius: 25px;
    background: #effcff;
    text-align: left;
  }

  #vd-app .vd-recordatorios h4 {
    margin: 0 0 12px;
    color: var(--vd-morado-oscuro);
    font-size: 1.17rem;
    font-weight: 900;
  }

  #vd-app .vd-recordatorios ul {
    margin: 0;
    padding-left: 1.4rem;
    list-style: disc;
  }

  #vd-app .vd-recordatorios li {
    margin-bottom: 10px;
    line-height: 1.4;
  }

  #vd-app .vd-ayuda {
    margin-top: 20px;
    padding: 17px;
    border-radius: 20px;
    background: #fff7d4;
    line-height: 1.45;
  }

  #vd-app .vd-confeti {
    position: fixed;
    z-index: 50;
    top: -20px;
    width: 12px;
    height: 18px;
    border-radius: 3px;
    pointer-events: none;
    animation: vd-caer 2.6s linear forwards;
  }

