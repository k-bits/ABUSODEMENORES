        explicacionIncorrecta: "❌ No es así. Tienes derecho a decir NO y contarlo a alguien de confianza. No debes quedarte callado.",
      },
      {
        personaje: "🦹‍♂️",
        nombre: "El Engañador",
        texto: "Esto es un secreto, no se lo digas a nadie.",
        correcta: false,
        explicacionCorrecta: "❌ No es verdad. Los secretos que asustan NO se guardan. Debes contarlos a un adulto de confianza.",
        explicacionIncorrecta: "✅ ¡Acertaste! Ese mensaje es incorrecto. Los secretos que preocupan siempre se cuentan.",
      },
      {
        personaje: "🦸‍♂️",
        nombre: "Capitán Valiente",
        texto: "Si la primera persona no me escucha, se lo cuento a otra hasta recibir ayuda.",
        correcta: true,
        explicacionCorrecta: "✅ ¡Muy bien! Puedes seguir contándolo hasta que alguien te proteja.",
        explicacionIncorrecta: "❌ No es así. No te rindas. Hay muchas personas que pueden ayudarte.",
      },
      {
        personaje: "👩‍🏫",
        nombre: "Señorita Ana",
        texto: "Como soy mayor que tú, tienes que hacerme caso en todo.",
        correcta: false,
        explicacionCorrecta: "❌ No es verdad. Nadie puede obligarte. Tú tienes derecho a decir NO a cualquier persona.",
        explicacionIncorrecta: "✅ ¡Acertaste! Ese mensaje es incorrecto. La edad no da derecho a mandar sobre ti.",
      },
      {
        personaje: "🦸‍♀️",
        nombre: "La Protectora",
        texto: "Si alguien me hace daño, la culpa no es mía. La culpa es de quien lo hace.",
        correcta: true,
        explicacionCorrecta: "✅ ¡Exacto! Nunca es culpa del niño. La responsabilidad es de la persona que actúa mal.",
        explicacionIncorrecta: "❌ No es así. Tú no tienes la culpa de nada. La culpa siempre es de quien lastima.",
      },
      {
        personaje: "🧙‍♂️",
        nombre: "El Confundidor",
        texto: "Solo pido ayuda si estoy completamente seguro de lo que pasó.",
        correcta: false,
        explicacionCorrecta: "❌ No es verdad. Puedes pedir ayuda incluso si estás confundido o no sabes explicarlo bien.",
        explicacionIncorrecta: "✅ ¡Acertaste! Ese mensaje es incorrecto. Pedir ayuda cuando algo te preocupa es valiente.",
      },
      {
        personaje: "👦",
        nombre: "Mateo",
        texto: "Aunque sea alguien que conozco, si no quiero que me toquen, digo NO.",
        correcta: true,
        explicacionCorrecta: "✅ ¡Correcto! No importa quién sea: conocido, familiar o amigo. Tú decides sobre tu cuerpo.",
        explicacionIncorrecta: "❌ No es así. Tu derecho a decir NO es igual para todas las personas.",
      },
      {
        personaje: "🐍",
        nombre: "La Mentirosa",
        texto: "Si alguien no me respeta, es culpa mía por no haber hablado antes.",
        correcta: false,
        explicacionCorrecta: "❌ No es verdad. La culpa nunca es tuya. La responsabilidad es de quien no respetó los límites.",
        explicacionIncorrecta: "✅ ¡Acertaste! Ese mensaje es incorrecto. Nadie tiene derecho a culparte por las acciones de otros.",
      },
    ];

    // === ELEMENTOS ===
    const pantallaInicio = $("#vd-inicio");
    const pantallaJuego = $("#vd-juego");
    const pantallaFinal = $("#vd-final");
    const botonComenzar = $("#vd-comenzar");
    const botonSiguiente = $<HTMLButtonElement>("#vd-siguiente");
    const botonReiniciar = $("#vd-reiniciar");
    const barraProgreso = $("#vd-barra");
    const progresoContenedor = $("#vd-progreso");
    const marcador = $("#vd-marcador");
    const numeroPregunta = $("#vd-numero");
    const personaje = $("#vd-personaje");
    const mensaje = $("#vd-mensaje");
    const retroalimentacion = $("#vd-retro");
    const puntuacionFinal = $("#vd-puntos");
    const mensajeMotivacion = $("#vd-motivacion");
    const botonesRespuesta = root.querySelectorAll<HTMLButtonElement>(".vd-respuesta");

    let preguntasJuego: typeof mensajes = [];
    let indiceActual = 0;
    let aciertos = 0;
    let fallos = 0;
    let respondida = false;

    function mezclar<T>(lista: T[]): T[] {
      const copia = [...lista];

      for (let i = copia.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [copia[i], copia[j]] = [copia[j], copia[i]];
      }

      return copia;
    }

    function iniciarJuego() {
      preguntasJuego = mezclar(mensajes);
      indiceActual = 0;
      aciertos = 0;
      fallos = 0;
      respondida = false;

      pantallaInicio.classList.add("vd-oculto");
      pantallaFinal.classList.add("vd-oculto");
      pantallaJuego.classList.remove("vd-oculto");

      mostrarPregunta();
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function mostrarPregunta() {
      respondida = false;

      const pregunta = preguntasJuego[indiceActual];
      const progreso = (indiceActual / preguntasJuego.length) * 100;

      barraProgreso.style.width = `${progreso}%`;
      progresoContenedor.setAttribute("aria-valuenow", String(Math.round(progreso)));
      marcador.textContent = `✅ ${aciertos} aciertos`;
      numeroPregunta.textContent = `Mensaje ${indiceActual + 1} de ${preguntasJuego.length}`;

      personaje.textContent = pregunta.personaje;
      personaje.setAttribute("aria-label", `Personaje: ${pregunta.nombre}`);
      mensaje.textContent = `“${pregunta.nombre} dice: ${pregunta.texto}”`;

      retroalimentacion.className = "vd-retro vd-oculto";
      retroalimentacion.textContent = "";
      botonSiguiente.classList.add("vd-oculto");
      botonesRespuesta.forEach((boton) => (boton.disabled = false));
    }

    function responder(eleccion: boolean) {
      if (respondida) return;
      respondida = true;

      const pregunta = preguntasJuego[indiceActual];
      const acerto = eleccion === pregunta.correcta;

      botonesRespuesta.forEach((boton) => (boton.disabled = true));
      retroalimentacion.classList.remove("vd-oculto");

      const explicacion = pregunta.correcta
        ? pregunta.explicacionCorrecta
        : pregunta.explicacionIncorrecta;

      if (acerto) {
        aciertos++;
        marcador.textContent = `✅ ${aciertos} aciertos`;
        retroalimentacion.classList.add("vd-bien");
        retroalimentacion.innerHTML = `<strong>🌟 ¡Acertaste!</strong><br>${explicacion}`;
        sonidoCorrecto();
      } else {
        fallos++;
        retroalimentacion.classList.add("vd-revisar");
        retroalimentacion.innerHTML = `<strong>💡 Vamos a aprenderlo.</strong><br>${explicacion}`;
        sonidoIncorrecto();
      }

      botonSiguiente.textContent =
        indiceActual === preguntasJuego.length - 1
          ? "Ver mi resultado 🏆"
          : "Siguiente mensaje ➜";

      botonSiguiente.classList.remove("vd-oculto");
      botonSiguiente.focus({ preventScroll: true });
    }

    function avanzar() {
      indiceActual += 1;

      if (indiceActual < preguntasJuego.length) {
        mostrarPregunta();
      } else {
        finalizarJuego();
      }
    }

    function finalizarJuego() {
      const total = preguntasJuego.length;

      barraProgreso.style.width = "100%";
      progresoContenedor.setAttribute("aria-valuenow", "100");
      pantallaJuego.classList.add("vd-oculto");
      pantallaFinal.classList.remove("vd-oculto");

      puntuacionFinal.innerHTML = `
        ✅ Acertaste: <strong>${aciertos}</strong> de ${total}<br>
        ❌ No acertaste: <strong>${fallos}</strong> de ${total}
      `;

      let mensajeFinal = "";

      if (aciertos === total) {
        mensajeFinal =
          "🏆 ¡Eres un verdadero Guardián de la Verdad! Sabes perfectamente cuidarte y pedir ayuda. ¡Felicidades!";
      } else if (aciertos >= total / 2) {
        mensajeFinal =
          "⭐ ¡Muy bien hecho! Estás aprendiendo a cuidarte cada día más. Sigue así, lo estás haciendo genial 💪";
      } else {
        mensajeFinal =
          "🌱 ¡Lo importante es aprender! Cada mensaje te enseña algo nuevo. Vuelve a jugar y verás cómo mejoras 🌟 ¡Tú puedes!";
      }

      mensajeMotivacion.textContent = mensajeFinal;

      crearConfeti();
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function crearConfeti() {
      const colores = ["#6c4bd8", "#39bce8", "#ffd95a", "#32b875", "#ff6f91"];

      for (let i = 0; i < 55; i += 1) {
        const pieza = document.createElement("span");

        pieza.className = "vd-confeti";
        pieza.style.left = `${Math.random() * 100}vw`;
        pieza.style.background =
          colores[Math.floor(Math.random() * colores.length)];
        pieza.style.animationDelay = `${Math.random() * 0.8}s`;
        pieza.style.animationDuration = `${2 + Math.random() * 1.5}s`;

        root.appendChild(pieza);

        window.setTimeout(() => pieza.remove(), 4000);
      }
    }

    botonesRespuesta.forEach((boton) => {
      boton.addEventListener("click", () => {
        responder(boton.dataset.respuesta === "true");
      });
    });

    botonComenzar.addEventListener("click", iniciarJuego);
    botonReiniciar.addEventListener("click", iniciarJuego);
    botonSiguiente.addEventListener("click", avanzar);
  })();
</script>
